// Dev container for editing the wiki. It reuses the root Dockerfile, so the
// Zensical version matches `docker compose` and CI. See CONTRIBUTING.md.
// Format reference: https://containers.dev/implementors/json_reference/
{
	"name": "PSForever Wiki",
	"build": {
		"dockerfile": "../Dockerfile",
		"context": "..",
		"target": "base"
	},
	"features": {
		"ghcr.io/devcontainers/features/common-utils:2": {
			"username": "vscode"
		},
		"ghcr.io/devcontainers/features/git:1": {
			"version": "os-provided"
		}
	},
	"forwardPorts": [8000],
	"portsAttributes": {
		"8000": {
			"label": "Wiki preview",
			"onAutoForward": "openBrowser"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"mathiassoeholm.markdown-link-updater",
				"dlyz.md-link-checker",
				"KlausJandl.markdownlinkcompletionprovider",
				"possan.nbsp-vscode",
				"EditorConfig.EditorConfig"
			]
		}
	},
	"remoteUser": "vscode"
}
